# Molecule test image (rendered by the docker driver for each platform image; every scenario's molecule.yml points
# its platforms here with dockerfile: ../shared/Dockerfile.j2).
# A RHEL-compatible base with what Ansible and the test fixture need on a target:
#   - a Python that ansible-core 2.22 supports (>= 3.9): python3.11 on release 8, the platform python3 on release 9;
#   - sudo (become to the database owner), GNU tar/gzip (unarchive), getent/gpasswd (glibc-common, shadow-utils:
#     group membership), procps-ng (ps: database owner and shutdown checks), util-linux (setsid: the stub database
#     and listener processes), openssl and ca-certificates (the test CA and the https artifact repository).
# coreutils is not listed: the base images ship coreutils-single, which conflicts with it.
# The Oracle prerequisite packages are installed by ../shared/prepare.yml from the role's own per-OS list, so the
# image does not repeat that list.
FROM {{ item.image }}

RUN . /etc/os-release \
    && case "$VERSION_ID" in 8*) python_package=python3.11 ;; *) python_package=python3 ;; esac \
    && dnf --assumeyes --setopt=install_weak_deps=False install "$python_package" sudo tar gzip \
         findutils procps-ng hostname which shadow-utils glibc-common diffutils util-linux openssl ca-certificates \
    && dnf clean all \
    && rm -rf /var/cache/dnf
